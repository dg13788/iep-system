# ============================================================
# IEP System - Environment Variables Example
# ============================================================
# Copy / inject these variables into your web server environment,
# container, or use a dotenv loader. Never commit real secrets.

# ----- Database -----
DB_HOST=localhost
DB_NAME=iep_system
DB_USER=root
# REQUIRED: set a real password in production
DB_PASS=your_strong_password

# ----- JWT -----
# Recommended: 32+ random characters (hex/base64).
# If unset, backend falls back to backend/config/jwt.secret,
# or auto-generates one on first run.
JWT_SECRET=
JWT_EXPIRE_DAYS=7

# ----- Security / Runtime -----
# Enable ONLY in development
IEP_DEBUG=false
# Comma-separated allowed CORS origins, e.g. https://app.example.com
ALLOWED_ORIGINS=

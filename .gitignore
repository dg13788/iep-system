# ============================================================
# IEP System - .gitignore (Open Source Skeleton Release)
#
# Encoding: UTF-8
# Principle: the repository tracks the SOURCE SKELETON only.
#   Runtime artifacts / secrets / logs / DB backups / demo data /
#   internal process docs are never committed.
# Chinese patterns below are UTF-8; keep this file UTF-8 encoded.
# ============================================================

# ===== Secrets & environment (only .env.example is tracked) =====
.env
.env.*
*.env
*.env.local
!.env.example
backend/config/jwt.secret

# ===== Dependencies & build artifacts =====
node_modules/
dist/
frontend/dist/
build/
*.tsbuildinfo
*.log
build.log
npm_install.log
vite_dev.log

# ===== Runtime logs / audit scripts / temp probes =====
backend/logs/
logs/
backend/api/_io_probe*.php

# ===== Database backups (contain real data, never commit) =====
backend/backups/
*.sql.gz

# ===== Local dev / backtest tools (not deliverables) =====
tools/
backend/tools/
backend/sql/seed_demo_v4.py
backend/sql/backfill_idcard_gen.py

# ===== Demo data packages (generators + intermediates, not skeleton) =====
demo_data/

# ===== Docs: DENY-ALL (default-deny) =====
# Enumerating internal doc names turned out to be fragile: every new audit /
# backtest / promotion / evidence-pack file silently slipped through the net.
# Default-deny — ALL docs are excluded from the public repo. This includes
# iep_technical_doc_v101.md: it is the full design blueprint (DB schema, API
# spec, permission model, security design) and is kept as a proprietary asset.
docs/*

# ===== Binary derivative docs (Markdown is the source of truth) =====
# Already covered by docs/* above; kept as a note so the intent stays visible.
# Also excluded for the same reason: the three pre-env-var deployment manuals
# (local / shared-hosting / cloud-server) that instruct editing define('DB_PASS')
# inside config.php. Current backend reads config from getenv().

# ===== Release artifacts (the skeleton zip is deliverable, not source) =====
*.zip

# ===== Root-level temp files & local installer =====
/build_log.txt
/tsc_log.txt
/vite_log.txt
/run_*.txt
/install_iep_local.bat
/IEP系统本机本地部署详细指南.md
*.tmp
*.bak

# ===== Internal slide decks =====
ppt/

# ===== IDE / OS =====
.idea/
.vscode/
*.suo
*.user
.DS_Store
Thumbs.db

# ===== WorkBuddy workspace data =====
.workbuddy/

# ===== Copyright application materials (proprietary, never public) =====
/软著申请/

# ===== Skeleton staging copy (duplicate of repo root, never commit) =====
/iep-system/
